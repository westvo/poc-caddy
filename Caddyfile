{
  email admin@sellersstar.com
}

# HTTP -> HTTPS redirect
:80 {
  @api {
    path /custom-domains*
  }
  
  handle @api {
    reverse_proxy api:3000
  }
  
  handle {
    reverse_proxy frontend:3001 {
      header_up Host {host}
    }
  }
}

# HTTPS with Let's Encrypt (auto SSL)
:443 {
  @api {
    path /custom-domains*
  }
  
  handle @api {
    reverse_proxy api:3000
  }
  
  handle {
    reverse_proxy frontend:3001 {
      header_up Host {host}
    }
  }
}

# Catch-all for custom domains (HTTP/HTTPS)
http://, https:// {
  @api {
    path /custom-domains*
  }
  
  handle @api {
    reverse_proxy api:3000
  }
  
  handle {
    reverse_proxy api:3000 {
      header_up Host {host}
    }
  }
}
