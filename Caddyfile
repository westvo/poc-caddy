{
  email admin@sellersstar.com
  on_demand_tls {
    ask http://api:3000/
  }
}

# Case 1: Management UI (localhost, server IP) - goes to frontend
localhost {
  @api {
    path /custom-domains* /performance/dashboard
  }
  
  handle @api {
    reverse_proxy api:3000
  }
  
  handle {
    reverse_proxy frontend:3001 {
      header_up Host {host}
    }
  }
}

gym-platform.store {
  @api {
    path /custom-domains* /performance/dashboard
  }
  
  handle @api {
    reverse_proxy api:3000
  }
  
  handle {
    reverse_proxy frontend:3001 {
      header_up Host {host}
    }
  }
}

# Case 2: Catch-all for custom domains ONLY - goes to backend (hello page)
# Explicitly exclude management hosts
https:// {
  tls {
    on_demand
  }

  @management host localhost gym-platform.store
  
  @api {
    path /custom-domains* /performance/dashboard
  }
  
  handle @api {
    reverse_proxy api:3000
  }
  
  handle @management {
    reverse_proxy frontend:3001 {
      header_up Host {host}
    }
  }
  
  handle {
    reverse_proxy api:3000 {
      header_up Host {host}
    }
  }
}

http:// {
  @management host localhost gym-platform.store
  
  @api {
    path /custom-domains* /performance/dashboard
  }
  
  handle @api {
    reverse_proxy api:3000
  }
  
  handle @management {
    reverse_proxy frontend:3001 {
      header_up Host {host}
    }
  }
  
  handle {
    reverse_proxy api:3000 {
      header_up Host {host}
    }
  }
}
