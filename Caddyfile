{
  email admin@sellersstar.com
  auto_https off
}

# Management UI (localhost, server IP) - goes to frontend
localhost, 222.255.214.97 {
  @api {
    path /custom-domains*
  }
  
  handle @api {
    reverse_proxy api:3000
  }
  
  handle {
    reverse_proxy frontend:3001 {
      header_up Host {host}
    }
  }
}

# Catch-all for custom domains - goes to backend (hello page)
:80 {
  @not_management not host localhost 222.255.214.97
  
  @api {
    path /custom-domains*
  }
  
  handle @api @not_management {
    reverse_proxy api:3000
  }
  
  handle @not_management {
    reverse_proxy api:3000 {
      header_up Host {host}
    }
  }
}
